# ─────────────────────────────────────────────
# DATABASE — Supabase Postgres
# ─────────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → "Connection string" → URI
# Use the POOLER URL for the app and the DIRECT URL for migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────
# LOCAL DATABASE (optional, easiest for testing)
# ─────────────────────────────────────────────
# If you want to run locally instead of Supabase:
# 1) `docker compose up -d`
# 2) set BOTH vars to the local URL below
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/social_studio"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/social_studio"

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
# Generate locally with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# ─────────────────────────────────────────────
# AI — Google Gemini
# ─────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash-lite"

# ─────────────────────────────────────────────
# EMAIL — Resend
# ─────────────────────────────────────────────
RESEND_API_KEY="re_xxx"
EMAIL_FROM="onboarding@resend.dev"

# ─────────────────────────────────────────────
# EMAIL — Free SMTP Fallback (e.g. Gmail App Password)
# ─────────────────────────────────────────────
# Use this to send emails to ANY recipient for free without owning a custom domain.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-personal-email@gmail.com"
# SMTP_PASS="your-gmail-16-character-app-password"

# ─────────────────────────────────────────────
# FILE STORAGE — Cloudinary (optional)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────────────────────────
# CRON (optional — used by /api/schedule/tick)
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# CRON_SECRET="replace-with-a-long-random-string"

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
